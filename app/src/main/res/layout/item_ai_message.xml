<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingStart="12dp"
    android:paddingEnd="48dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:orientation="horizontal">

    <!-- Salony Mini Avatar -->
    <ImageView
        android:id="@+id/ivAiAvatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="2dp"
        android:src="@drawable/img_salony_avatar"
        android:contentDescription="Salony Avatar" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_ai_bubble"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvAiMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp" />

        <!-- Action Badge -->
        <TextView
            android:id="@+id/tvActionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_chip_active"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/pink_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Action Buttons &amp; Time Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAiTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <!-- Play Voice -->
            <ImageButton
                android:id="@+id/btnPlayVoice"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Play Voice"
                android:tint="@color/pink_accent" />

            <!-- Stop Voice -->
            <ImageButton
                android:id="@+id/btnStopVoice"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_pause"
                android:contentDescription="Stop Voice"
                android:tint="@color/text_muted"
                android:visibility="gone" />

            <!-- Copy -->
            <ImageButton
                android:id="@+id/btnCopyText"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                android:contentDescription="Copy Text"
                android:tint="@color/text_secondary" />

            <!-- Share -->
            <ImageButton
                android:id="@+id/btnShareText"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Share Text"
                android:tint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
